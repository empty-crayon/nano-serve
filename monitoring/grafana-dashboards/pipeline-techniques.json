    {
      "type": "timeseries",
      "title": "Token rates \u2014 by technique",
      "description": "Prompt and completion token rates from gateway counters (requires stream_options enabled).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tok/s"
        }
