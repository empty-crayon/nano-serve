          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (technique) (rate(nanoserve_prompt_tokens_total{technique!=\"unknown\"}[5m]))",
          "legendFormat": "prompt \u2014 {{technique}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
