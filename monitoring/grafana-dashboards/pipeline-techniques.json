      "targets": [
        {
          "expr": "histogram_quantile($percentile, sum by (le, technique) (rate(nanoserve_completion_tokens_per_second_bucket{technique!=\"unknown\"}[5m])))",
          "legendFormat": "{{technique}}",
          "datasource": {
            "type": "prometheus",
