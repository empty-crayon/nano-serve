    },
    {
      "type": "timeseries",
      "title": "Request duration distribution \u2014 by technique",
      "description": "Heatmap-style: average request duration per technique over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum by (technique) (rate(nanoserve_request_duration_seconds_sum{technique!=\"unknown\"}[5m])) / clamp_min(sum by (technique) (rate(nanoserve_request_duration_seconds_count{technique!=\"unknown\"}[5m])), 1e-10)",
          "legendFormat": "avg \u2014 {{technique}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
