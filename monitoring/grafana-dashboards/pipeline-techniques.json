      },
      "targets": [
        {
          "expr": "histogram_quantile($percentile, sum by (le, technique) (rate(nanoserve_request_duration_seconds_bucket{technique!=\"unknown\"}[5m])))",
          "legendFormat": "{{technique}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
